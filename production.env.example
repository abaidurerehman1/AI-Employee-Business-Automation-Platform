# Copy to production.env (ignored by Git). No production service is started by
# validation; use the standalone compose.production.yaml, not the dev Compose.
PRODUCTION_BACKEND_ENV_FILE=./backend/.env.production
PRODUCTION_DATABASE_URL=postgresql+asyncpg://app:replace_with_url_encoded_password@database-host:5432/ai_employee
PRODUCTION_REDIS_URL=rediss://redis-host:6379/0
PRODUCTION_TEMPORAL_ADDRESS=temporal-host:7233
PUBLIC_FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com/api/v1
PRODUCTION_CORS_ORIGINS=["https://app.example.com"]
PRODUCTION_ALLOWED_HOSTS=["api.example.com","localhost","backend"]
