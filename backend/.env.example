APP_NAME=AI Employee Platform API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://ai_employee:change_me@localhost:55432/ai_employee
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=ai_employee_session
SESSION_DAYS=7
SECURE_COOKIES=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
EMAILS_ENABLED=false
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MESSAGING_PUBLIC_BASE_URL=
MESSAGING_UNSUBSCRIBE_SECRET=
MESSAGING_HOURLY_LIMIT=100
CAMPAIGN_MAX_RECIPIENTS=1000
CAMPAIGN_EMAIL_INTERVAL_SECONDS=2
CAMPAIGN_SMS_INTERVAL_SECONDS=1
# Optional E.164 country calling prefixes, e.g. ["+1","+44"]
CAMPAIGN_ALLOWED_SMS_PREFIXES=[]
# Development only: campaigns to the connected Gmail account itself, with a local unsubscribe link.
CAMPAIGN_ALLOW_LOCAL_GMAIL_SELF_TEST=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/messaging/gmail/callback
OAUTH_ENCRYPTION_KEY=
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_INPUT_CHARACTERS=100000
EMBEDDING_MODEL=text-embedding-3-small
MAX_DOCUMENT_BYTES=10485760
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","testserver","test"]
HEALTH_TIMEOUT_SECONDS=2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_START=true
FORWARDED_ALLOW_IPS=127.0.0.1
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
AUTH_REQUESTS_PER_MINUTE=10

